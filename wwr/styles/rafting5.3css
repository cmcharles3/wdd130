/* Define CSS variables */
:root {
    --primary-color: #055a05;
    /* forest green */
    --secondary-color: #f4a261;
    /* warm sand */
    --accent1-color: #264653;
    /* dark slate blue */
    --heading-font: "Times New Roman", "Georgia", serif;
    --body-font: Arial, Helvetica, sans-serif;
}

/* 4.Reset CSS box-model properties */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* 5.body-font */
body {
    font-family: var(--body-font);

    color: var(--accent1-color);
    line-height: 1.6;
    background-color: #fcfcfc;

}

/* 6. Page limitation and alignment */
header,
main,
footer {
    width: 840px;
    margin: 0 auto;
}

/* 7.Header Styling */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    background-color: var(--primary-color);
}

header img {
    max-height: 35rem;
    width: auto;
}

header nav {
    display: flex;
    justify-content: flex-end;
    gap: 2rem;
}

header nav ul {
    list-style-type: none;
    display: flex;
    gap: 10rem
}

header nav a {
    color: #fff;
    text-decoration: none;
    font-weight: bold;
}

/* --
header nav a:hover {
    color: var(--secondary-color);
} -- */
header nav a:hover {
    text-decoration: underline;
    color: var(--secondary-color);
}

h1,
h2 {
    font-family: var(--heading-font);
    color: var(--primary-color);
}

/* 8.basic style */
nav,
p,
section,
article {
    margin: 16px;
    padding: 8px;
}

.history h2 {
    text-align: center;
    margin-bottom: 10px;
    color: #004d25;
}

.history-content {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    max-width: 900px;
    margin: 0 auto;
}

.history-content img {
    width: 200px;
    height: auto;
    display: block;
    border-radius: 6px;
}

.history-content p {
    line-height: 1.5;
    text-align: left;
}

/* -- Adventure section; horizontal 5 image span -- 
.adventure-gallery {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    flex-wrap: wrap;
}

.adventure-gallery figure {
    flex: 1 1 5%;
    /* --5 columns distributed evenly -- 
    text-align: center;
    margin: 0;
}

/* .adventure-gallery figcaption {
    font-size: 0.9rem;
    margin-top: 0.5rem;
    font-weight: 600;
} */

/* --- ADVENTURES SECTION --- */
.adventures {
    /* padding: 40px 20px; */
    text-align: center;
    background-color: #f4f4f4;
}

.adventures h2 {
    margin-bottom: 25px;
}

/* 5 Images layout horizontally using Grid */
.adventure-gallery {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 15px;
    max-width: 1200px;
    margin: 0 auto;
}

.adventure-gallery figure {
    margin: 0;
    background: #ffffff;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.adventure-gallery img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    display: block;
}

.adventure-gallery figcaption {
    padding: 10px 5px;
    font-size: 0.9rem;
    font-weight: bold;
    color: #003366;
}

/* Footer & Social Media Icon Configuration */
footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--accent1-color);
    color: #fff;
    /* padding: 10px 16px; */
    padding: 1.5rem 2rem;
    margin-top: 30px;
}

footer .social-links {
    display: flex;
    gap: 1rem;
}

footer .social-links img {
    width: 24px;
    height: 24px;
}

footer p {
    margin: 0;
}

.socialmedia {
    display: flex;
    gap: 15px;
    margin: 0;
    padding: 0;
}

.socialmedia a {
    text-decoration: none;
}

.socialmedia img {
    width: 24px;
    height: 24px;
}

/* --- div style --- */

.hero {
    position: relative;
    margin: 0;

}

.hero img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
}

/* Styling h1*/
.hero h1 {
    position: absolute;
    top: 20px;
    width: 100%;
    padding: 16px;
    text-align: center;
    opacity: 0.85;
    background-color: var(--accent1-color);
    color: #fff;
}

/* Article */
.hero article {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: 4px;
    padding: 15px;
    margin: 0;
}

.hero article p {
    color: #111;
    line-height: 1.6;
    margin: 0;
}

/* image */
.hero article img {
    float: right;
    width: 70px;
    margin-left: 15px;
    margin-bottom: 5px;
    border: 3px solid var(--primary-color);
    box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);

}